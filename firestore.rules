rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Đơn giản: ai mở app cũng đọc và ghi được. Phù hợp khi chỉ chia hồ sơ cho người quen.
    match /profiles/{profile}/{document=**} {
      allow read, write: if true;
    }
    match /profiles/{profile} {
      allow read, write: if true;
    }
  }
}
